---
import ServiceIcon from './ServiceIcon.astro';
import { services } from '../data/site';
---

<section id="services" aria-labelledby="services-title" class="bg-surface">
  <h2 id="services-title" class="sr-only">Our construction services</h2>
  <ul
    class="mx-auto grid max-w-[1280px] grid-cols-2 gap-y-12 px-4 py-12 sm:px-8 lg:grid-cols-4 lg:gap-y-0 lg:px-0 lg:pt-[44px] lg:pb-14"
  >
    {
      services.map((service, i) => (
        <li
          data-reveal
          style={`--delay:${i * 110}ms`}
          class:list={[
            'group flex flex-col items-center px-3 text-center sm:px-6',
            i % 2 === 1 && 'border-l border-line',
            i === 2 && 'lg:border-l lg:border-line',
          ]}
        >
          <ServiceIcon
            name={service.icon}
            class="h-[58px] w-auto transition-transform duration-500 ease-out-expo group-hover:-translate-y-1.5 sm:h-[66px] lg:h-[73px]"
          />
          <h3 class="mt-4 text-[17px] leading-7 font-bold text-ink transition-colors duration-300 group-hover:text-brand-ink sm:text-[18px] lg:mt-[20px] lg:text-[19px]">
            {service.title}
          </h3>
          <p class="mt-2 max-w-[250px] text-[14px] leading-[1.6] text-[#6a6e74] sm:text-[15px]">{service.description}</p>
        </li>
      ))
    }
  </ul>
</section>
