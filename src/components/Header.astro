---
import Logo from './Logo.astro';
import ArrowRight from './ArrowRight.astro';
import { nav } from '../data/site';
---

<header
  data-site-header
  data-scrolled="false"
  class="sticky top-0 z-50 bg-[#fbfcfe] shadow-[0_1px_0_rgb(15_23_42/0.06),0_8px_20px_-14px_rgb(15_23_42/0.35)] transition-[background-color,box-shadow] duration-300 data-[scrolled=true]:bg-[#fbfcfe]/90 data-[scrolled=true]:shadow-[0_1px_0_rgb(15_23_42/0.06),0_14px_30px_-18px_rgb(2_20_32/0.45)] data-[scrolled=true]:backdrop-blur-md data-[scrolled=true]:backdrop-saturate-150"
>
  <div
    class="mx-auto flex h-[72px] max-w-[1440px] items-center px-5 sm:px-8 lg:h-[96px] xl:h-[114px] xl:px-[52px]"
  >
    <a href="#home" class="group shrink-0" aria-label="BuildCore Construction — Home">
      <Logo />
    </a>

    <nav aria-label="Main navigation" class="ml-auto hidden xl:block">
      <ul class="flex items-center gap-10 min-[1400px]:gap-[58px]">
        {
          nav.map((item, i) => (
            <li>
              <a
                href={item.href}
                data-nav-link
                aria-current={i === 0 ? 'true' : undefined}
                class="relative block py-2 text-[17.5px] font-medium text-[#4d4f53] transition-colors duration-300 after:absolute after:inset-x-0 after:top-[calc(100%+9px)] after:h-[2px] after:origin-left after:scale-x-0 after:bg-brand after:transition-transform after:duration-500 after:ease-out-expo hover:text-ink hover:after:scale-x-100 aria-[current=true]:font-semibold aria-[current=true]:text-ink aria-[current=true]:after:scale-x-100"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-3 xl:ml-10 min-[1400px]:ml-[58px]">
      <a
        href="#contact"
        class="btn btn-primary hidden h-[46px]! px-6! text-[15px]! shadow-[0_6px_16px_-8px_rgb(246_176_36/0.7)] sm:inline-flex lg:h-[52px]! xl:h-[58px]! xl:px-[30px]! xl:text-[17px]!"
        style="gap:24px"
      >
        Get a quote
        <ArrowRight class="h-[18px] w-[18px]" />
      </a>

      <button
        type="button"
        class="group inline-flex h-11 w-11 items-center justify-center rounded-[4px] text-ink transition-colors hover:bg-black/5 xl:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open menu"
        data-menu-toggle
      >
        <span class="relative block h-[14px] w-6" aria-hidden="true">
          <span class="absolute top-0 left-0 h-[2px] w-6 rounded bg-current transition-transform duration-300 ease-out-expo group-aria-expanded:translate-y-[6px] group-aria-expanded:rotate-45"></span>
          <span class="absolute top-[6px] left-0 h-[2px] w-6 rounded bg-current transition-opacity duration-200 group-aria-expanded:opacity-0"></span>
          <span class="absolute top-[12px] left-0 h-[2px] w-6 rounded bg-current transition-transform duration-300 ease-out-expo group-aria-expanded:-translate-y-[6px] group-aria-expanded:-rotate-45"></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Barra de progreso de lectura -->
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[3px]" aria-hidden="true">
    <div class="scroll-progress h-full w-full bg-brand"></div>
  </div>

  <div
    id="mobile-menu"
    data-open="false"
    inert
    class="invisible absolute inset-x-0 top-full -translate-y-2 border-t border-line bg-white opacity-0 shadow-[0_18px_30px_-18px_rgb(2_20_32/0.45)] transition-[opacity,translate,visibility] duration-300 ease-out-expo data-[open=true]:visible data-[open=true]:translate-y-0 data-[open=true]:opacity-100 xl:hidden"
  >
    <nav aria-label="Mobile navigation" class="mx-auto max-w-[1440px] px-5 pt-2 pb-6 sm:px-8">
      <ul class="divide-y divide-line">
        {
          nav.map((item, i) => (
            <li
              class="translate-x-[-12px] opacity-0 transition-[opacity,translate] duration-500 ease-out-expo in-data-[open=true]:translate-x-0 in-data-[open=true]:opacity-100"
              style={`transition-delay:${60 + i * 45}ms`}
            >
              <a
                href={item.href}
                data-nav-link
                aria-current={i === 0 ? 'true' : undefined}
                class="group/link flex items-center justify-between py-4 text-[17px] font-medium text-[#3f4246] aria-[current=true]:font-semibold aria-[current=true]:text-ink"
              >
                {item.label}
                <ArrowRight class="h-4 w-4 text-brand transition-transform duration-300 group-hover/link:translate-x-1" />
              </a>
            </li>
          ))
        }
      </ul>
      <a href="#contact" class="btn btn-primary mt-5 w-full sm:hidden">
        Get a quote
        <ArrowRight class="h-[18px] w-[18px]" />
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.dataset.open = String(open);
    menu.toggleAttribute('inert', !open);
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  window.matchMedia('(min-width: 80rem)').addEventListener('change', (e) => e.matches && setOpen(false));

  // Header con sombra y desenfoque al hacer scroll.
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      header?.setAttribute('data-scrolled', String(window.scrollY > 8));
      ticking = false;
    });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Resalta en el menú la sección visible (subrayado amarillo como en el diseño).
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const sections = [...new Set(links.map((a) => a.hash))]
    .map((hash) => document.querySelector<HTMLElement>(hash))
    .filter((el): el is HTMLElement => Boolean(el));

  if ('IntersectionObserver' in window && sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const hash = `#${entry.target.id}`;
          links.forEach((a) => (a.hash === hash ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>
