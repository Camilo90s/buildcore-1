---
const items = [
  'Residential',
  'Commercial',
  'Industrial',
  'Design & Build',
  'Renovations',
  'Project Management',
  'Site Planning',
];
---

<section aria-label="Our specialties" class="marquee relative overflow-hidden bg-brand py-5 sm:py-6">
  <div class="marquee-track flex w-max">
    {
      [0, 1].map((copy) => (
        <ul class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
          {items.map((item) => (
            <li class="flex items-center gap-8 pr-8 font-display text-[24px] leading-none font-bold whitespace-nowrap text-navy uppercase sm:gap-10 sm:pr-10 sm:text-[30px]">
              {item}
              <svg class="h-6 w-6 shrink-0 sm:h-7 sm:w-7" viewBox="0 0 64 64" aria-hidden="true">
                <path fill="currentColor" d="M1 27.6a2 2 0 0 1 1.4-1.9l13.2-4.2a1 1 0 0 1 1.3 1V62a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2Z" />
                <path fill="currentColor" d="M21 9.5C21 4 26 1 31.5 1S42 4 42 9.5V62a2 2 0 0 1-2 2H23a2 2 0 0 1-2-2Z" />
                <path fill="currentColor" d="M63 27.6a2 2 0 0 0-1.4-1.9l-13.2-4.2a1 1 0 0 0-1.3 1V62a2 2 0 0 0 2 2h11.9a2 2 0 0 0 2-2Z" />
              </svg>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</section>
