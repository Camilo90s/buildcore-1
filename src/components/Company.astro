---
import { features } from '../data/site';

const icons: Record<string, string> = {
  shield: 'M12 3 4.5 6v5.5c0 4.6 3.1 8.4 7.5 9.5 4.4-1.1 7.5-4.9 7.5-9.5V6L12 3Zm-3.2 9.2 2.3 2.3 4.4-4.6',
  clock: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-13.5V12l3 2',
  badge: 'M12 15a6 6 0 1 0 0-12 6 6 0 0 0 0 12Zm-3.5 4.2L8 22l4-2 4 2-.5-2.8M9.6 9.2l1.6 1.6 3.2-3.2',
  tag: 'M3.5 12.6V4.5a1 1 0 0 1 1-1h8.1a1 1 0 0 1 .7.3l7.4 7.4a1 1 0 0 1 0 1.4l-8.1 8.1a1 1 0 0 1-1.4 0l-7.4-7.4a1 1 0 0 1-.3-.7ZM8.5 9a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1Z',
};
---

<section id="company" aria-labelledby="company-title" class="bg-surface py-20 lg:py-28">
  <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12 xl:px-[70px]">
    <div class="mx-auto max-w-[720px] text-center">
      <p class="eyebrow" data-reveal>Our company</p>
      <h2 id="company-title" class="section-title mt-4 text-navy" data-reveal style="--delay:80ms">Why clients choose BuildCore</h2>
      <p class="mt-5 text-[17px] leading-[1.75] text-muted" data-reveal style="--delay:160ms">
        Precision planning, skilled people and open communication from the first sketch to the final key handover.
      </p>
    </div>

    <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        features.map((feature, i) => (
          <li data-reveal style={`--delay:${i * 110}ms`}>
           <div class="group relative h-full overflow-hidden rounded-[4px] border border-line bg-white p-8 transition-[translate,box-shadow,border-color] duration-500 ease-out-expo hover:-translate-y-1.5 hover:border-transparent hover:shadow-[0_24px_44px_-24px_rgb(2_20_32/0.4)]">
            <span class="absolute inset-x-0 top-0 h-[3px] origin-left scale-x-0 bg-brand transition-transform duration-500 ease-out-expo group-hover:scale-x-100" aria-hidden="true" />
            <span class="grid h-14 w-14 place-items-center rounded-[4px] bg-navy text-brand transition-[background-color,color,rotate] duration-500 ease-out-expo group-hover:-rotate-6 group-hover:bg-brand group-hover:text-navy">
              <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={icons[feature.icon]} />
              </svg>
            </span>
            <h3 class="mt-6 font-display text-[22px] font-bold text-navy uppercase">{feature.title}</h3>
            <p class="mt-2 text-[15.5px] leading-[1.65] text-muted">{feature.description}</p>
           </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
