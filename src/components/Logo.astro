---
interface Props {
  variant?: 'dark' | 'light';
  class?: string;
}
const { variant = 'dark', class: className } = Astro.props;
const isLight = variant === 'light';
---

<span class:list={['flex items-center gap-3 sm:gap-4', className]}>
  <svg
    class="h-10 w-10 shrink-0 sm:h-12 sm:w-12 xl:h-[63px] xl:w-[63px]"
    viewBox="0 0 64 64"
    aria-hidden="true"
    focusable="false"
  >
    <path fill="#F6B024" d="M1 27.6a2 2 0 0 1 1.4-1.9l13.2-4.2a1 1 0 0 1 1.3 1V62a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2Z"></path>
    <path fill="#F6B024" d="M21 9.5C21 4 26 1 31.5 1S42 4 42 9.5V62a2 2 0 0 1-2 2H23a2 2 0 0 1-2-2Z"></path>
    <path fill="#F6B024" d="M63 27.6a2 2 0 0 0-1.4-1.9l-13.2-4.2a1 1 0 0 0-1.3 1V62a2 2 0 0 0 2 2h11.9a2 2 0 0 0 2-2Z"></path>
  </svg>
  <span class="flex flex-col leading-none">
    <span
      class:list={[
        'font-display text-[24px] font-bold tracking-[-0.005em] sm:text-[27px] xl:text-[31px]',
        isLight ? 'text-white' : 'text-[#101113]',
      ]}>BUILDCORE</span
    >
    <span
      class:list={[
        'mt-[5px] font-sans text-[10.5px] font-medium tracking-[0.42em] sm:text-[11.5px] xl:mt-[8px] xl:text-[12px]',
        isLight ? 'text-white/70' : 'text-[#4a4c50]',
      ]}>CONSTRUCTION</span
    >
  </span>
</span>
