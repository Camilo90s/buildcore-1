---
import { Image } from 'astro:assets';
import ArrowRight from './ArrowRight.astro';
import { projects } from '../data/site';
// Marcador de posición: reemplaza por una foto real por proyecto.
import placeholder from '../assets/hero-building.jpg';
---

<section id="projects" aria-labelledby="projects-title" class="bg-navy py-20 text-white lg:py-28">
  <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12 xl:px-[70px]">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <p class="eyebrow text-brand" data-reveal>Our projects</p>
        <h2 id="projects-title" class="section-title mt-4" data-reveal style="--delay:80ms">Featured work</h2>
      </div>
      <div data-reveal style="--delay:160ms">
      <a
        href="#contact"
        class="group inline-flex items-center gap-3 font-display text-[17px] font-bold tracking-[0.01em] uppercase transition-colors hover:text-brand"
      >
        Start your project
        <ArrowRight class="h-[18px] w-[18px] text-brand transition-transform duration-300 group-hover:translate-x-1.5" />
      </a>
      </div>
    </div>

    <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project, i) => (
          <li data-reveal style={`--delay:${i * 130}ms`}>
            <article class="group relative overflow-hidden rounded-[4px] bg-navy-800">
              <Image
                src={placeholder}
                alt={`${project.title} — ${project.category.toLowerCase()} project in ${project.location}`}
                widths={[400, 640, 900]}
                sizes="(min-width: 1024px) 31vw, (min-width: 768px) 48vw, 100vw"
                loading="lazy"
                class="aspect-[4/3] h-auto w-full object-cover transition-transform duration-[1.2s] ease-out-expo group-hover:scale-110"
                style={`object-position: ${project.focus}`}
              />
              <div
                class="absolute inset-0 bg-linear-to-t from-navy via-navy/30 to-transparent transition-opacity duration-500 group-hover:opacity-90"
                aria-hidden="true"
              />
              <span
                class="absolute top-5 right-5 grid h-12 w-12 -translate-y-2 place-items-center rounded-full bg-brand text-navy opacity-0 transition-[opacity,translate] duration-500 ease-out-expo group-hover:translate-y-0 group-hover:opacity-100"
                aria-hidden="true"
              >
                <ArrowRight class="h-5 w-5 -rotate-45" />
              </span>
              <div class="absolute inset-x-0 bottom-0 p-6 transition-transform duration-500 ease-out-expo group-hover:-translate-y-2 sm:p-7">
                <span class="inline-block rounded-[3px] bg-brand px-2.5 py-1 font-display text-[13px] font-bold tracking-[0.08em] text-[#1d1505] uppercase">
                  {project.category}
                </span>
                <h3 class="mt-3 font-display text-[24px] leading-tight font-bold uppercase">{project.title}</h3>
                <p class="mt-1 text-[15px] text-white/75">
                  {project.location} · {project.year}
                </p>
              </div>
              <span
                class="absolute inset-x-0 bottom-0 h-1 origin-left scale-x-0 bg-brand transition-transform duration-700 ease-out-expo group-hover:scale-x-100"
                aria-hidden="true"
              />
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
